# Copy to .env and adjust as needed. Nothing here is read with a hardcoded
# fallback to "localhost" in source - see app/db.py and app/main.py.

# Full SQLAlchemy URL. Default (if unset) is a SQLite file at backend/data/aei_upload.db
DATABASE_URL=

# Host/port to bind Uvicorn to. Pass explicitly on the command line, e.g.
# uv run uvicorn app.main:app --host 0.0.0.0 --port 8008
HOST=0.0.0.0
PORT=8008

# Directory containing the built Next.js static export served at "/".
# Default (if unset) is ../frontend/out relative to the backend directory.
FRONTEND_DIST_DIR=
